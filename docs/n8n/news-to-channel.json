      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://noti.kalon-ai.app/api/bot/sendMessage",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer YOUR_BOT_TOKEN"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ roomId: 'YOUR_CHANNEL_ROOM_ID', text: '📰 ' + $json.title + '\\n' + $json.link }) }}",
        "options": {}
      },
      "name": "โพสต์ลงชาเนล",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
