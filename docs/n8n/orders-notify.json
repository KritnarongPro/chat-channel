        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer YOUR_BOT_TOKEN"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ roomId: 'YOUR_SHOP_GROUP_ROOM_ID', text: '🛒 ออเดอร์ใหม่ #' + $json.body.order.id + ' จาก ' + $json.body.order.userName + '\\n' + $json.body.order.items.map(i => i.label + ': ' + (i.value ?? '-')).join('\\n') }) }}",
        "options": {}
      },
      "name": "แจ้งในกลุ่มร้าน",
